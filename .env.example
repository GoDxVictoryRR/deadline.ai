# ============================================================
# DeadlineAI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# See .agents/security-deployment.md for setup instructions.
# ============================================================

# ── Firebase (from Firebase Console → Project Settings → Your apps) ──────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Firebase Storage is NOT used in this project, but the SDK field is required.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Gemini (from Google AI Studio → Get API Key) ─────────────────────────────
# Restrict this key to:
#   • API: Gemini API only
#   • HTTP referrers: your Firebase Hosting domain + localhost
VITE_GEMINI_API_KEY=

# ── Google Apps Script Web App ───────────────────────────────────────────────
# Deployed URL from your standalone Apps Script project.
# See .agents/security-deployment.md step-by-step setup for this value.
VITE_APPS_SCRIPT_URL=
