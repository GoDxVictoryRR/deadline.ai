rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny — no access unless explicitly granted below.
    match /{document=**} {
      allow read, write: if false;
    }

    // tasks collection — owner only
    match /tasks/{taskId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null
                                  && resource.data.userId == request.auth.uid;
    }

    // dailyFeasibility collection — owner only
    match /dailyFeasibility/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null
                                  && resource.data.userId == request.auth.uid;
    }

    // users collection — each user may only access their own document
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // notifications_log collection — owner only
    match /notifications_log/{logId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
    }
  }
}
